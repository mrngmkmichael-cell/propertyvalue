{
  "manifest_version": 3,
  "name": "UKPropertyInsight Overlay",
  "version": "2.1.0",
  "description": "See sold prices, comparables, schools, EPC, demographics, crime and more for any Rightmove, Zoopla or OnTheMarket listing, without leaving the page.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.rightmove.co.uk/properties/*",
        "https://www.zoopla.co.uk/for-sale/details/*",
        "https://www.zoopla.co.uk/to-rent/details/*",
        "https://www.onthemarket.com/details/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://ukpropertyinsight.co.uk/*"
  ]
}
