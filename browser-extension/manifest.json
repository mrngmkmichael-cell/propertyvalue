{
  "manifest_version": 3,
  "name": "UKPropertyInsight Overlay",
  "version": "2.2.0",
  "description": "Sold price history, EPC, schools, flood risk and crime data for Rightmove, Zoopla and OnTheMarket listings.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.rightmove.co.uk/properties/*",
        "https://www.zoopla.co.uk/for-sale/details/*",
        "https://www.zoopla.co.uk/to-rent/details/*",
        "https://www.onthemarket.com/details/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://ukpropertyinsight.co.uk/*"
  ]
}
