# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real secrets.

# Bearer token from your account page at
# https://get-energy-performance-data.communities.gov.uk
EPC_API_TOKEN=

# API key from your Rail Data Marketplace subscription to the
# LDBWS (Live Departure Board Web Service) product -
# https://raildata.org.uk. Powers the "fastest train to the nearest
# big city" figure on the Getting Around card. The site works fine
# without it, just with that figure hidden.
LDBWS_API_KEY=

# Connection string from your Neon project dashboard.
# Enables accounts + watchlist; the site works fine without it,
# just with that feature hidden.
DATABASE_URL=

# Random secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Google Cloud API key, "Maps JavaScript API" enabled, restricted to
# your site's domain (HTTP referrer restriction). Billed - paid API,
# used with the free $200/month Google Maps Platform credit. The site
# falls back to free Leaflet/OpenStreetMap maps without it.
GOOGLE_MAPS_API_KEY=

# A SEPARATE Google Cloud API key, "Places API (New)" enabled, for the
# Google ratings shown alongside Food Hygiene ratings. Billed per
# request (~$32/1000), on top of whatever GOOGLE_MAPS_API_KEY uses -
# same shared free credit. Must NOT have an HTTP referrer restriction
# (this is called from the server, not a browser) - restrict by IP or
# by API instead. The site skips this section entirely without it.
GOOGLE_PLACES_API_KEY=
